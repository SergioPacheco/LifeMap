# ============================================================
# Report services — server-only environment (NEVER ship to frontend).
# The frontend knows exactly one variable: PUBLIC_REPORT_API_URL.
# Copy to .env (gitignored) for local compose runs.
# ============================================================

# Postgres connection for API + worker (compose default shown).
DATABASE_URL=postgres://reports:reports-dev-only@127.0.0.1:5432/reports

# Private artifact directory (PDF/document bytes; local backend).
ARTIFACT_DIR=./var/artifacts

# OpenAI key and model selection (task 4; unused by the fake pipeline).
OPENAI_API_KEY=
OPENAI_REPORT_MODEL=
OPENAI_REVIEW_MODEL=

# Finance guardrails (USD). No job is accepted above these.
REPORT_MAX_COST_USD=25
REPORT_OWNER_QUOTA_USD=10
REPORT_USD_PER_1K_TOKENS=0.01
REPORT_SAMPLE_QUOTA=5

# Pilot allowlist (comma-separated owner IDs, task 6 fills via grants).
REPORT_PILOT_OWNERS=

# API hardening.
PORT=4100
REPORT_BODY_LIMIT_BYTES=262144
REPORT_RATE_WINDOW_MS=60000
REPORT_RATE_MAX=120
REPORT_ALLOWED_ORIGINS=

# Worker.
REPORT_LEASE_SECONDS=60
REPORT_WORKER_POLL_MS=2000

# Frontend (public, build-time): the ONLY report variable in the browser.
PUBLIC_REPORT_API_URL=http://127.0.0.1:4100
